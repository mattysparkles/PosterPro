[Unit]
Description=PosterPro immutable release retention
After=opt-apps-posterpro.mount
Requires=opt-apps-posterpro.mount

[Service]
Type=oneshot
User=root
ExecStartPre=/mnt/posterprodata/migration-reports/controllers/posterpro-volume-guard
ExecStart=/usr/bin/python3 /opt/apps/posterpro/canonical/ops/release/prune_releases.py --apply
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/apps/posterpro/releases /run/lock
