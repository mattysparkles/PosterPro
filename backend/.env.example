APP_BASE_URL=https://posterpro.sparkleserver.site
ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3030,http://127.0.0.1:3030,https://posterpro.sparkleserver.site
DATABASE_URL=postgresql+psycopg2://USERNAME:PASSWORD@localhost:5432/posterpro
REDIS_URL=redis://localhost:6379/1
STORAGE_ROOT=./storage
STARTUP_SCHEMA_COMPAT_ENABLED=true
SESSION_SECRET=replace-with-a-long-random-secret
OPENAI_API_KEY_ENC=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET_ENC=
EBAY_RUNAME=
EBAY_REDIRECT_URI=
PHOTOROOM_API_KEY_ENC=
AUTOMATION_BRIDGE_ENABLED=false
AUTOMATION_BRIDGE_URL=
AUTOMATION_BRIDGE_TIMEOUT_SECONDS=30
AUTOMATION_BRIDGE_VNC_HOST=127.0.0.1
AUTOMATION_BRIDGE_VNC_PORT=5901
AUTOMATION_BRIDGE_DATA_DIR=./bridge-data
AUTOMATION_BRIDGE_RUNNER_MODE=simulated
AUTOMATION_BRIDGE_JOB_DELAY_SECONDS=0.3
AUTOMATION_BRIDGE_MAX_WORKERS=4
AUTOMATION_BRIDGE_API_KEY_ENC=
AUTONOMOUS_MODE=true
AUTONOMOUS_DRY_RUN=false
MAX_CONCURRENT_BULK_TASKS=50
BULK_CHUNK_SIZE=0
AMAZON_VINE_IMPORT_ENABLED=false
AMAZON_VINE_IMPORT_PREMIUM_ONLY=false
AMAZON_MEDIA_LOOKUP_ENABLED=false
AMAZON_MEDIA_PAGE_FALLBACK_ENABLED=false
AMAZON_MARKETPLACE_REGION=US
AMAZON_MEDIA_FETCH_MODE=manual_only
AMAZON_MEDIA_RATE_LIMIT_PER_MINUTE=12
AMAZON_PAAPI_ACCESS_KEY_ENC=
AMAZON_PAAPI_SECRET_KEY_ENC=
AMAZON_PAAPI_PARTNER_TAG_ENC=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD_ENC=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=PosterPro
SMTP_USE_TLS=true
