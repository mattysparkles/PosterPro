[Unit]
Description=PosterPro FastAPI Backend
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
WorkingDirectory=/opt/apps/posterpro/repo/backend
EnvironmentFile=/opt/apps/posterpro/repo/backend/.env
ExecStart=/opt/apps/posterpro/repo/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8030
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
